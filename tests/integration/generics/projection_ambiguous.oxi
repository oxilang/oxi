// @expect-error unresolved_assoc_type

trait Bar {
    type BarTy;

    fn qux() Self::BarTy;
}

struct Foo<T> {}

impl Bar for Foo::<i32> {
    type BarTy = i32;

    fn qux() Self::BarTy {
        12
    }
}

impl Bar for Foo::<bool> {
    type BarTy = bool;

    fn qux() Self::BarTy {
        true
    }
}

fn project<T>(_: Foo::<T>) <Foo::<T> as Bar>::BarTy {
    let _ = 0;
}

pub fn main() void {
    let x = project(Foo::<i32> {});
}
