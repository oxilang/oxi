pub trait Add<Rhs = Self> {
    type Output;

    fn add(self: Self, rhs: Rhs) Self::Output;
}

struct Vec2<T = i32> {
    x: T,
    y: T,
}

impl Add for Vec2 {
    type Output = Self;

    fn add(self: Self, rhs: Self) Self {
        Self {
            x: self.x + rhs.x,
            y: self.y + rhs.y
        }
    }
}
