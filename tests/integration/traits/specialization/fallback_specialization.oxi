// @expect-error type_mismatch

struct Foo {
    data: i64,
}

trait Add<T = Self> {
    fn add(self: &Self, rhs: &T) T;
}

impl Add::<i64> for Foo {
    fn add(self: &Self, rhs: &i64) i64 {
        self.data + rhs@
    }
}

pub fn main() () {
    let foo = Foo { data: 12 };
    let r = foo.add(&true);
}
